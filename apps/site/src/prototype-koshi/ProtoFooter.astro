---
/* PROTOTYPE — jetable. Le pied sombre au grand nom écrit ; rien que du contenu réel. */
import { getCollection } from "astro:content";
import { SITE_TITLE } from "../site.js";

const projects = (await getCollection("projects")).map((entry) => entry.data);
---

<footer class="k-footer">
  <div class="k-footer__top">
    <nav aria-label="Le site">
      <p class="k-footer__label">Le site</p>
      <ul>
        <li><a href="/" data-proto-anchor="manifeste">Manifeste</a></li>
        <li><a href="/" data-proto-anchor="pieces">Pièces</a></li>
        <li><a href="/" data-proto-anchor="projets">Projets</a></li>
      </ul>
    </nav>
    <nav aria-label="Les projets" class="k-footer__projects">
      <p class="k-footer__label">Projets</p>
      <ul lang="zh-Hant">
        {
          projects.map((project) => (
            <li>
              <a href={project.href}>{project.title.traditional}</a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
  <p class="k-footer__name" lang="zh-Hant" aria-hidden="true">{SITE_TITLE}</p>
  <p class="k-footer__motto">Soutenu par le maître, je suis les vagues</p>
</footer>
