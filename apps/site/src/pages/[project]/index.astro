---
import type { GetStaticPaths } from "astro";
import { getCollection } from "astro:content";
import { pieceHref } from "@bsls/content";
import Layout from "../../layouts/Layout.astro";
import PieceCard from "../../components/PieceCard.astro";
import UnscannedPieces from "../../components/UnscannedPieces.astro";
import { hang } from "../../hang.js";

export const getStaticPaths = (async () => {
  const projects = await getCollection("projects");
  const pieces = (await getCollection("pieces")).map((entry) => entry.data);

  return projects.map((entry) => ({
    params: { project: entry.data.id },
    props: {
      project: entry.data,
      pieces: pieces.filter((piece) => piece.projects.includes(entry.data.id)),
    },
  }));
}) satisfies GetStaticPaths;

const { project, pieces } = Astro.props;
const { wall, unscanned } = hang(pieces);
---

<Layout title={project.title.traditional}>
  <nav class="breadcrumb"><a href="/">Accueil</a></nav>
  <h2 lang="zh-Hant">{project.title.traditional}</h2>
  {
    project.gloss ? (
      <p class="gloss" data-testid="gloss">
        {project.gloss}
      </p>
    ) : null
  }
  {project.presentation ? <p class="reading__body">{project.presentation}</p> : null}

  <section aria-labelledby="oeuvres">
    <h3 id="oeuvres">Pièces · {wall.length}</h3>
    <ul class="card-list">
      {wall.map((piece) => <PieceCard piece={piece} href={pieceHref(piece.slug, project.id)} />)}
    </ul>
  </section>

  <UnscannedPieces pieces={unscanned} level={3} projectId={project.id} />
</Layout>
