---
import type { GetStaticPaths } from "astro";
import { getCollection } from "astro:content";
import Layout from "../../layouts/Layout.astro";
import Pinyin from "../../components/Pinyin.astro";
import Wall from "../../components/Wall.astro";
import UnscannedPieces from "../../components/UnscannedPieces.astro";
import { hang } from "../../hang.js";

export const getStaticPaths = (async () => {
  const projects = await getCollection("projects");
  const pieces = (await getCollection("pieces")).map((entry) => entry.data);

  return projects.map((entry) => ({
    params: { project: entry.data.id },
    props: {
      project: entry.data,
      pieces: pieces.filter((piece) => piece.projects.includes(entry.data.id)),
    },
  }));
}) satisfies GetStaticPaths;

const { project, pieces } = Astro.props;
const { wall, unscanned } = hang(pieces);
---

<Layout title={project.title.traditional}>
  <div class="project grid">
    <header class="project__intro">
      <h2 class="project__title" lang="zh-Hant">
        <Pinyin pinyin={project.title.pinyin}>{project.title.traditional}</Pinyin>
      </h2>
      {
        project.gloss ? (
          <p class="gloss" data-testid="gloss">
            {project.gloss}
          </p>
        ) : null
      }
      {
        project.presentation ? (
          <p class="project__presentation reading__body">{project.presentation}</p>
        ) : null
      }
    </header>

    <div class="project__pieces">
      <section aria-labelledby="mur">
        <h3 id="mur">Pièces · {wall.length}</h3>
        <Wall pieces={wall} projectId={project.id} />
      </section>

      <UnscannedPieces pieces={unscanned} level={3} projectId={project.id} />
    </div>
  </div>
</Layout>
