---
import "../styles/global.css";
import { ClientRouter } from "astro:transitions";
import SiteHeader from "../components/SiteHeader.astro";

type Props = {
  title: string;
};

const { title } = Astro.props;
// Seul l'accueil porte l'en-tête en grand : `data-page` le dit à l'en-tête persistant.
const page = Astro.url.pathname === "/" ? "home" : "inner";
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} — 背山臨水</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Noto+Serif+TC:wght@400;600&display=swap"
    />
    <ClientRouter />
  </head>
  <body>
    <div class="page">
      <SiteHeader />
      <main id="contenu" data-page={page} tabindex="-1">
        <slot />
      </main>
    </div>
    <script>
      // Après une navigation sans rechargement, le focus reprend au début du
      // nouveau contenu, comme au chargement d'une page. `astro:after-swap` ne
      // suit que les navigations : le premier chargement garde son focus.
      document.addEventListener("astro:after-swap", () => {
        document.getElementById("contenu")?.focus({ preventScroll: true });
      });
    </script>
  </body>
</html>
