---
import "../styles/global.css";
import "../styles/site-font.css";
import SiteHeader from "../components/SiteHeader.astro";
import { SITE_FONT_FACE, SITE_FONT_URL, SITE_TITLE } from "../site.js";

type Props = {
  title: string;
};

const { title } = Astro.props;
// Seul l'accueil porte l'en-tête en grand.
const home = Astro.url.pathname === "/";
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} — {SITE_TITLE}</title>
    <link rel="preload" href={SITE_FONT_URL} as="font" type="font/woff2" crossorigin />
    <style is:inline set:html={SITE_FONT_FACE}></style>
  </head>
  <body>
    <div class="page">
      <SiteHeader large={home} />
      <main>
        <slot />
      </main>
    </div>
  </body>
</html>
