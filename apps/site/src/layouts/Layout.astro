---
import "../styles/global.css";
import "../styles/site-font.css";
import { ClientRouter } from "astro:transitions";
import SiteHeader from "../components/SiteHeader.astro";
import siteFontFace from "virtual:bsls/site-font-face";
import { SITE_FONT_URL, SITE_TITLE } from "../site.js";

type Props = {
  title: string;
};

const { title } = Astro.props;
// Seul l'accueil porte l'en-tête en grand : `data-page` le dit à l'en-tête persistant.
const page = Astro.url.pathname === "/" ? "home" : "inner";

/**
 * Le contenu s'efface, puis le nouveau apparaît une fois l'ancien parti : 250 ms
 * chacun, sans chevauchement (pagetransitions.netlify.app). Les images clés
 * `sortie` et `entree` sont dans `global.css`.
 */
const fade = {
  old: { name: "sortie", duration: "250ms", easing: "ease-in", fillMode: "both" },
  new: { name: "entree", duration: "250ms", easing: "ease-out", delay: "250ms", fillMode: "both" },
};
const pageFade = { forwards: fade, backwards: fade };
// Sans View Transitions, la page change d'un coup : le repli `swap` d'Astro
// remplace le contenu sans simuler les fondus.
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} — {SITE_TITLE}</title>
    <link rel="preload" href={SITE_FONT_URL} as="font" type="font/woff2" crossorigin />
    <style is:inline set:html={siteFontFace}></style>
    <ClientRouter fallback="swap" />
  </head>
  <body>
    <div class="page">
      <SiteHeader />
      <main
        id="contenu"
        data-page={page}
        tabindex="-1"
        transition:name="contenu"
        transition:animate={pageFade}
      >
        <slot />
      </main>
    </div>
    <script>
      // Après une navigation sans rechargement, le focus reprend au début du
      // nouveau contenu, comme au chargement d'une page. `astro:after-swap` ne
      // suit que les navigations : le premier chargement garde son focus.
      document.addEventListener("astro:after-swap", () => {
        document.getElementById("contenu")?.focus({ preventScroll: true });
      });
    </script>
  </body>
</html>
