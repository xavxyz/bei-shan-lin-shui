---
import type { LoadedPiece } from "@bsls/schema";
import VersionFacts from "./VersionFacts.astro";
import VersionText from "./VersionText.astro";
import VersionVariations from "./VersionVariations.astro";
import { hasImage } from "../version-images.js";

type Props = {
  piece: LoadedPiece;
};

const { piece } = Astro.props;

/** Toutes les versions sauf la courante, de la plus ancienne à la plus récente. */
const earlier = piece.versions.filter((version) => version.id !== piece.latestVersion.id);
const headingId = "versions-anterieures";
---

{
  earlier.length > 0 ? (
    <section class="evolution" aria-labelledby={headingId}>
      <h3 class="evolution__heading" id={headingId}>
        Versions antérieures
      </h3>
      <ol class="evolution__list">
        {earlier.map((version) => (
          <li
            class:list={["piece", { "piece--textual": !hasImage(version) }]}
            data-testid="earlier-version"
          >
            {hasImage(version) ? (
              <div class="piece__work">
                <VersionVariations version={version} title={piece.title.traditional} />
              </div>
            ) : null}

            <div class="piece__text">
              {version.columns.length > 0 ? <VersionText version={version} /> : null}

              <VersionFacts version={version} testIdPrefix="earlier-version" />

              {hasImage(version) ? null : (
                <VersionVariations version={version} title={piece.title.traditional} />
              )}

              {version.intention ? (
                <div class="piece__prose">
                  <div class="reading__block">
                    <p class="reading__label">Intention</p>
                    <p class="reading__body" data-testid="earlier-version-intention">
                      {version.intention.trim()}
                    </p>
                  </div>
                </div>
              ) : null}
            </div>
          </li>
        ))}
      </ol>
    </section>
  ) : null
}
