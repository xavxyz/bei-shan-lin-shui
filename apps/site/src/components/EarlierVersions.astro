---
import type { LoadedPiece } from "@bsls/schema";
import VersionFacts from "./VersionFacts.astro";
import VersionVisAVis from "./VersionVisAVis.astro";

type Props = {
  piece: LoadedPiece;
};

const { piece } = Astro.props;

/** Toutes les versions sauf la courante, de la plus ancienne à la plus récente. */
const earlier = piece.versions.filter((version) => version.id !== piece.latestVersion.id);
const headingId = "versions-anterieures";
---

{
  earlier.length > 0 ? (
    <section class="evolution" aria-labelledby={headingId}>
      <h3 class="evolution__heading" id={headingId}>
        Versions antérieures
      </h3>
      <ol class="evolution__list">
        {earlier.map((version) => (
          <VersionVisAVis
            version={version}
            title={piece.title.traditional}
            tag="li"
            testIdPrefix="earlier-version"
          >
            <VersionFacts slot="facts" version={version} testIdPrefix="earlier-version" />
          </VersionVisAVis>
        ))}
      </ol>
    </section>
  ) : null
}
