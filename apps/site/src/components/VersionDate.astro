---
import type { LoadedVersion } from "@bsls/schema";
import { frenchDate } from "../french-date.js";

type Props = {
  version: LoadedVersion;
  /** La date en français, ou la date chinoise, qui se lit en simplifié. */
  calendar: "french" | "chinese";
  /** L'élément qui porte la date chinoise : `dd` dans les faits d'une version. */
  tag?: "span" | "dd";
  /** Le repère de test de la date chinoise. */
  testId?: string;
};

/* Une date de version, l'une ou l'autre : la seule source de leur rendu. */
const { version, calendar, tag: Element = "span", testId } = Astro.props;
---

{
  calendar === "french" ? (
    <time datetime={version.date}>{frenchDate(version.date)}</time>
  ) : (
    <Element lang="zh-Hans" data-testid={testId}>
      {version.chineseDate.simplified}
    </Element>
  )
}
