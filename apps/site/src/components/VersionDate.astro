---
import type { LoadedVersion } from "@bsls/schema";
import { frenchDate } from "../french-date.js";

/** La date en français, ou la date chinoise, qui se lit en simplifié. */
type Props =
  | { version: LoadedVersion; calendar: "french" }
  | {
      version: LoadedVersion;
      calendar: "chinese";
      /** L'élément qui porte la date chinoise : `dd` dans les faits d'une version. */
      tag?: "span" | "dd";
      /** Le repère de test de la date chinoise. */
      testId?: string;
    };

/* Une date de version, l'une ou l'autre : la seule source de leur rendu. */
const props = Astro.props;
const Element = props.calendar === "chinese" ? (props.tag ?? "span") : "span";
---

{
  props.calendar === "french" ? (
    <time datetime={props.version.date}>{frenchDate(props.version.date)}</time>
  ) : (
    <Element lang="zh-Hans" data-testid={props.testId}>
      {props.version.chineseDate.simplified}
    </Element>
  )
}
