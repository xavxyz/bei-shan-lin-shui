---
import type { LoadedVersion } from "@bsls/schema";

type Props = {
  version: LoadedVersion;
  testId: string;
};

const { version, testId } = Astro.props;

/** `YYYY-MM-DD` lu comme un jour civil, sans glissement de fuseau. */
const frenchDate = new Date(`${version.date}T00:00:00Z`).toLocaleDateString("fr-FR", {
  day: "numeric",
  month: "long",
  year: "numeric",
  timeZone: "UTC",
});
---

<span class="tag" data-testid={testId}>
  <time datetime={version.date}>{frenchDate}</time>
  {" · "}
  <span lang="zh-Hant">{version.chineseDate}</span>
</span>
