---
import type { LoadedManifesto } from "@bsls/schema";
import ManifestoParagraph from "./ManifestoParagraph.astro";

/**
 * Le manifeste de 山山 sur l'accueil, en entier, cité tel qu'il est écrit, en
 * simplifié (ADR 0007) : chaque paragraphe en regard de sa traduction, les
 * premiers visibles, la suite à déplier. L'épigraphe, en traditionnel, se tient
 * en colonne à côté du texte.
 */
type Props = { manifesto: LoadedManifesto };

const { manifesto } = Astro.props;
/** Les paragraphes lus d'emblée ; la suite attend que le visiteur l'ouvre. */
const PARAGRAPHS_SHOWN_FIRST = 3;
const firstParagraphs = manifesto.paragraphs.slice(0, PARAGRAPHS_SHOWN_FIRST);
const remainingParagraphs = manifesto.paragraphs.slice(PARAGRAPHS_SHOWN_FIRST);
---

<section class="manifesto grid" aria-labelledby="manifeste">
  <!-- Muette pour un lecteur d'écran : elle redit un passage du dernier paragraphe. -->
  <p class="manifesto__epigraph" lang="zh-Hant" aria-hidden="true">{manifesto.epigraph}</p>
  <div class="manifesto__text">
    <h2 id="manifeste" class="manifesto__title">
      <span lang="zh-Hans">{manifesto.title}</span>
      <span class="manifesto__french-title">{manifesto.french_title}</span>
    </h2>
    <ol class="manifesto__paragraphs">
      {firstParagraphs.map((paragraph) => <ManifestoParagraph paragraph={paragraph} />)}
    </ol>
    {
      remainingParagraphs.length > 0 && (
        <details class="manifesto__rest">
          <summary>La suite du manifeste</summary>
          <ol class="manifesto__paragraphs" start={PARAGRAPHS_SHOWN_FIRST + 1}>
            {remainingParagraphs.map((paragraph) => (
              <ManifestoParagraph paragraph={paragraph} />
            ))}
          </ol>
        </details>
      )
    }
    <p class="manifesto__signature" lang="zh-Hans">{manifesto.signature}</p>
    <p class="manifesto__translator">
      Traduction de <span lang="zh-Hans">{manifesto.translator}</span>
    </p>
  </div>
</section>
