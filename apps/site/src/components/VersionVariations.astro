---
import type { LoadedVersion } from "@bsls/schema";
import { ImageViewer } from "../islands/ImageViewer.js";

type Props = {
  /** N'importe quelle version de la pièce, courante ou antérieure. */
  version: LoadedVersion;
  /** Titre de la pièce, pour décrire les images à qui ne les voit pas. */
  title: string;
};

const { version, title } = Astro.props;
---

<section class="variations" id={version.id} aria-label="Variations">
  <ImageViewer client:load variations={version.variations} title={title} />
</section>
