---
import type { LoadedVersion } from "@bsls/schema";

type Props = {
  version: LoadedVersion;
};

/*
 * Le texte d'une version à l'horizontale, une ligne par colonne de l'œuvre.
 * Traduite, elle se lit en tableau, simplifié en regard du français : le schéma
 * garantit une ligne de traduction par colonne. Sinon, une simple liste.
 */
const { version } = Astro.props;
const translation = version.translation;
---

{
  translation ? (
    <table class="version-text" data-testid="version-text">
      <thead>
        <tr>
          <th scope="col">Chinois simplifié</th>
          <th scope="col">Français</th>
        </tr>
      </thead>
      <tbody>
        {version.columns.map((column, index) => (
          <tr>
            <td class="version-text__zh" lang="zh-Hans">
              {column.simplified}
            </td>
            <td class="version-text__fr">{translation[index]}</td>
          </tr>
        ))}
      </tbody>
    </table>
  ) : (
    <ol class="version-text version-text--lines" data-testid="version-text" lang="zh-Hans">
      {version.columns.map((column) => (
        <li class="version-text__zh">{column.simplified}</li>
      ))}
    </ol>
  )
}
