---
import type { LoadedVersion } from "@bsls/schema";

type Props = {
  version: LoadedVersion;
  testId: string;
};

const { version, testId } = Astro.props;
const { formatLabel } = version;
---

<span data-testid={testId}>
  {
    /* Une notation illisible est son propre libellé : rien à redire en petit. */
    formatLabel.readable ? (
      <>
        <span data-testid="format-label">{formatLabel.text}</span>{" "}
        <small class="format__notation" data-testid="format-notation">
          {version.format}
        </small>
      </>
    ) : (
      <span data-testid="format-label">{version.format}</span>
    )
  }
</span>
