---
import type { LoadedPiece } from "@bsls/schema";
import Pinyin from "./Pinyin.astro";

type Props = {
  /** Une pièce du mur : elle a toujours une image (`hang`). */
  piece: LoadedPiece;
  href: string;
};

const { piece, href } = Astro.props;
---

<li class="wall__item">
  <a class="wall__work" href={href} data-testid="piece-link">
    {
      piece.featuredImage ? (
        <img class="wall__image" src={piece.featuredImage.src} alt="" loading="lazy" />
      ) : null
    }
    <h3 class="wall__title" lang="zh-Hant">
      <Pinyin pinyin={piece.title.pinyin}>{piece.title.traditional}</Pinyin>
    </h3>
    {
      piece.gloss ? (
        <p class="gloss" data-testid="gloss">
          {piece.gloss}
        </p>
      ) : null
    }
    {piece.published ? null : <span class="tag tag--unpublished">non publiée</span>}
  </a>
</li>
