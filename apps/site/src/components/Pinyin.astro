---
import { nextPinyinId } from "../pinyin-id.js";

type Props = {
  /** Le pinyin du texte enveloppé, dérivé par le content layer. */
  pinyin: string;
};

/*
 * Le pinyin en popover, partagé par les titres et les lignes du texte : il
 * s'ouvre au survol, au focus et au toucher, et se ferme par Échap ou par un
 * toucher ailleurs (`pinyin-popover.ts`).
 *
 * Le popover décrit son texte (`aria-describedby`) : un lecteur d'écran le lit
 * en pinyin. Fermé, il est vide : le pinyin n'entre ni dans le texte de la page,
 * ni dans le nom d'un titre ou d'un lien.
 */
const { pinyin } = Astro.props;
const id = nextPinyinId();
---

<span class="pinyin" data-pinyin={pinyin} aria-describedby={id}
  ><slot /><span class="pinyin__popover" id={id} role="tooltip" lang="zh-Latn-pinyin" hidden
  ></span></span
>

<script>
  import { watchPinyinPopovers } from "../pinyin-popover.js";

  watchPinyinPopovers();
</script>
