---
import type { LoadedPiece, LoadedProject } from "@bsls/schema";
import EarlierVersions from "./EarlierVersions.astro";
import VersionFacts from "./VersionFacts.astro";
import VersionText from "./VersionText.astro";
import VersionVariations from "./VersionVariations.astro";
import { hasImage } from "../version-images.js";

type Props = {
  piece: LoadedPiece;
  /** Projets d'où la pièce est accessible, pour le fil d'Ariane. */
  projects: LoadedProject[];
};

/*
 * La page pièce en Vis-à-vis : l'œuvre à gauche, qui tient à l'écran ; à
 * droite, le texte qui défile. Sous 64 rem, tout s'empile, le titre d'abord.
 */
const { piece, projects } = Astro.props;
const version = piece.latestVersion;
const source = piece.source;
const withWork = hasImage(version);
---

<article>
  <div class:list={["piece", { "piece--textual": !withWork }]}>
    {
      withWork ? (
        <div class="piece__work">
          <VersionVariations version={version} title={piece.title.traditional} />
        </div>
      ) : null
    }

    <div class="piece__text">
      <header class="piece__header">
        <nav class="breadcrumb" aria-label="Fil d'Ariane">
          <a href="/">Accueil</a>
          {
            projects.map((project) => (
              <>
                {" / "}
                <a href={project.href} lang="zh-Hant">
                  {project.title.traditional}
                </a>
              </>
            ))
          }
        </nav>
        <h2 class="piece__title" lang="zh-Hant">{piece.title.traditional}</h2>
        {
          piece.gloss ? (
            <p class="gloss" data-testid="gloss">
              {piece.gloss}
            </p>
          ) : null
        }
        {
          piece.published ? null : (
            <p>
              <span class="tag tag--unpublished" data-testid="unpublished">
                non publiée
              </span>
            </p>
          )
        }
      </header>

      {
        version.columns.length > 0 ? (
          <div class="piece__reading">
            <VersionText version={version} />
            <div class="reading__block">
              <p class="reading__label">Prononciation</p>
              <p class="reading__body pinyin" lang="zh-Latn-pinyin" data-testid="pinyin">
                {version.columns.map((column) => column.pinyin).join(" / ")}
              </p>
            </div>
          </div>
        ) : null
      }

      <VersionFacts version={version} piece={piece} testIdPrefix="version" />

      {withWork ? null : <VersionVariations version={version} title={piece.title.traditional} />}

      {
        version.intention || source?.full_text ? (
          <div class="piece__prose">
            {version.intention ? (
              <div class="reading__block">
                <p class="reading__label">Intention</p>
                <p class="reading__body">{version.intention.trim()}</p>
              </div>
            ) : null}

            {source?.full_text ? (
              <div class="reading__block">
                <p class="reading__label">Texte intégral</p>
                <p class="reading__body" lang="zh-Hant">
                  {source.full_text.traditional}
                </p>
              </div>
            ) : null}
          </div>
        ) : null
      }
    </div>
  </div>

  <EarlierVersions piece={piece} />
</article>
