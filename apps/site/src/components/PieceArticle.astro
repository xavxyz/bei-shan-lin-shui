---
import type { LoadedPiece, LoadedProject } from "@bsls/schema";
import EarlierVersions from "./EarlierVersions.astro";
import Gloss from "./Gloss.astro";
import Pinyin from "./Pinyin.astro";
import VersionFacts from "./VersionFacts.astro";
import VersionVisAVis from "./VersionVisAVis.astro";
import { workTransitionName } from "../work-transition.js";

type Props = {
  piece: LoadedPiece;
  /** Projets d'où la pièce est accessible, pour le fil d'Ariane. */
  projects: LoadedProject[];
};

/*
 * La page pièce : sa version courante en Vis-à-vis, l'en-tête de la pièce en
 * tête du texte, le texte intégral de la source après l'intention ; puis ses
 * versions antérieures. Sous 64 rem, tout s'empile, le titre d'abord.
 */
const { piece, projects } = Astro.props;
const version = piece.latestVersion;
const source = piece.source;
---

<article>
  <VersionVisAVis
    version={version}
    title={piece.title.traditional}
    tag="div"
    testIdPrefix="version"
    transitionName={workTransitionName(piece.slug)}
  >
    <header class="piece__header" slot="header">
      <nav class="breadcrumb" aria-label="Fil d'Ariane">
        <a href="/">Accueil</a>
        {
          projects.map((project) => (
            <>
              {" / "}
              <a href={project.href} lang="zh-Hant">
                {project.title.traditional}
              </a>
            </>
          ))
        }
      </nav>
      <h2 class="piece__title" lang="zh-Hant">
        <Pinyin pinyin={piece.title.pinyin}>{piece.title.traditional}</Pinyin>
      </h2>
      <Gloss gloss={piece.gloss} />
      {
        piece.published ? null : (
          <p>
            <span class="tag tag--unpublished" data-testid="unpublished">
              non publiée
            </span>
          </p>
        )
      }
    </header>

    <VersionFacts
      slot="facts"
      version={version}
      testIdPrefix="version"
      scriptLabel={piece.featuredScriptLabel}
      status={piece.status}
      attribution={source?.attribution}
    />

    <Fragment slot="prose">
      {
        source?.full_text ? (
          <div class="reading__block">
            <p class="reading__label">Texte intégral</p>
            <p class="reading__body" lang="zh-Hant">
              {source.full_text.traditional}
            </p>
          </div>
        ) : null
      }
    </Fragment>
  </VersionVisAVis>

  <EarlierVersions piece={piece} />
</article>
