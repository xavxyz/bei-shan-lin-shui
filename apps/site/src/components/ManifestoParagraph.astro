---
import type { ManifestoParagraph } from "@bsls/schema";

/** Un paragraphe du manifeste, tel qu'il est écrit, en regard de sa traduction. */
type Props = { paragraph: ManifestoParagraph };

const { paragraph } = Astro.props;
---

<li>
  <p lang="zh-Hans">{paragraph.zh}</p>
  <p>{paragraph.fr}</p>
</li>
