---
/*
 * L'en-tête persiste d'une page à l'autre : le routeur client le garde tel quel
 * au lieu de prendre celui de la nouvelle page. Il ne peut donc pas dépendre
 * d'une prop de page. C'est `<main data-page>`, échangé à chaque navigation,
 * qui le fait passer de grand (accueil) à réduit (ailleurs), en CSS.
 */
import { SITE_TITLE } from "../site.js";
---

<header class="site-header" transition:persist="site-header">
  <h1 class="site-header__title" lang="zh-Hant" transition:name="site-title">
    <a href="/">{SITE_TITLE}</a>
  </h1>
  <p class="site-header__motto" transition:name="site-motto">
    Soutenu par le maître, je suis les vagues
  </p>
  {/* PROTOTYPE — jetable : la navigation à filets des variantes. */}
  <nav class="k-nav" aria-label="Le site">
    <a href="/" data-proto-anchor="manifeste">Manifeste</a>
    <a href="/" data-proto-anchor="pieces">Pièces</a>
    <a href="/" data-proto-anchor="projets">Projets</a>
  </nav>
</header>
