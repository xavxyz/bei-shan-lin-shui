{
  "name": "bei-shan-lin-shui",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.22.0",
  "scripts": {
    "typecheck": "pnpm -r typecheck",
    "test": "vitest run",
    "test:e2e": "pnpm --filter @bsls/site test:e2e",
    "build": "pnpm --filter @bsls/site build",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "validate:content": "tsx packages/content/src/cli/validate.ts content && tsx packages/content/src/cli/memory-marks.ts content docs/sources",
    "validate:imports": "tsx packages/notion-import/src/cli/validate-imports.ts imports content",
    "validate:repo": "vitest run packages/repo-checks",
    "import:notion": "tsx packages/notion-import/src/cli/import-notion.ts",
    "import:plan-versions": "tsx packages/notion-import/src/cli/convert-plan-versions.ts",
    "attach:scan": "tsx packages/scans/src/cli/attach-scan.ts",
    "piece": "tsx packages/authoring/src/cli/piece.ts",
    "grilles": "tsx packages/grilles/src/cli/grilles.ts",
    "cosmos": "pnpm --filter @bsls/site cosmos",
    "prepare": "husky"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "husky": "^9.1.7",
    "prettier": "^3.4.2",
    "prettier-plugin-astro": "^0.14.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
